# ==============================================================================
# STYLERADAR · VARIABLES DE ENTORNO LOCALES (.env)
# Microservicio: CADCHE-Users-Service (ms-usuarios) · Puerto 8120
# Copie este archivo como .env y cambie los valores. Nunca suba el .env real.
# ==============================================================================

# Servidor y perfil de Spring (dev, qa o prod)
SERVER_PORT=8120
SPRING_PROFILES_ACTIVE=dev

# Persistencia PostgreSQL (docker-compose arma DB_URL, DB_USERNAME y DB_PASSWORD con estos valores)
POSTGRES_DB=usuarios_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT_EXTERNAL=5432
FLYWAY_ENABLED=true
JPA_DDL_AUTO=validate

# Broker de eventos (RabbitMQ): eventos de cuenta, estado y búsquedas guardadas
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT_EXTERNAL=5672
RABBITMQ_MGMT_PORT_EXTERNAL=15672

# Credencial Basic de las rutas internas /api/v1/internal/** (la usa ms-auth)
INTERNAL_AUTH_USERNAME=ms-usuarios-local
INTERNAL_AUTH_PASSWORD=cambiar-esta-clave-local

# Seguridad JWT: debe ser la misma clave Base64 que usa ms-auth
JWT_SECRET_BASE64=c3R5bGVyYWRhci1sb2NhbC1vbmx5LWp3dC1zZWNyZXQta2V5LTIwMjY=

# Cliente HTTP hacia ms-item-catalogo (feed y recomendaciones)
CATALOGO_API_BASE_URL=https://rst-itemcatalog-service-qa.redwave-74d6e30f.northcentralus.azurecontainerapps.io
